<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC-43 Gap 5: backup and device-to-device rules (API 31+).
     allowBackup="false" alone does not stop API 31+ device transfer, so
     both cloud-backup and device-transfer exclude the offline SQLite
     store and SharedPreferences. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
