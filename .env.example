# Travel Buddy MVP - Environment Variables
# Copy to .env and fill in your values
# ==========================================

# --- App ---
TB_APP_NAME=Travel Buddy AI
TB_DEBUG=true
# TB_LLM_DEBUG=false  # Set true to dump full LiteLLM/OpenAI request bodies.
#                      # WARNING: logs embedding arrays, prompt text, and masked auth headers.
#                      # Leave false for normal development — TB_DEBUG does NOT enable this.
TB_GEO_FENCE=dubai_uae

# --- Database (Supabase) ---
TB_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role key (Settings > API > service_role). NOT the anon/publishable key --
# the backend must bypass RLS to write. Never put this key in the Flutter app.
TB_SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
TB_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- LLM (LiteLLM) ---
TB_LITELLM_API_KEY=your_openai_api_key
TB_HEAVY_MODEL=gpt-4o
TB_LIGHT_MODEL=gpt-4o-mini
TB_EMBEDDING_MODEL=text-embedding-3-small

# Gemini: not used (light_model=gpt-4o-mini uses the same OpenAI key).
# Uncomment only if you switch TB_LIGHT_MODEL back to gemini/*.
# GEMINI_API_KEY=your_google_ai_key

# --- Google Maps ---
TB_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
TB_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# --- Weather ---
TB_OPENWEATHER_API_KEY=your_openweathermap_api_key

# --- Payments ---
TB_STRIPE_SECRET_KEY=sk_live_XXXXXXX
TB_STRIPE_WEBHOOK_SECRET=whsec_XXXXXXX
TB_REVENUECAT_API_KEY=your_revenuecat_api_key

# --- Guardrails ---
TB_MAX_DAILY_REROUTES_FREE=5
TB_MAX_DAILY_REROUTES_PRO=50
TB_SEMANTIC_CACHE_THRESHOLD=0.92
TB_MAX_LOOP_DEPTH=3
TB_SPONSORED_BOOST_MULTIPLIER=0.15

# --- Server ---
TB_HOST=0.0.0.0
TB_PORT=8000
