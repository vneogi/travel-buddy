# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/

# Curation working copies -- human-readable UTF-8 for editing, never committed.
# Use scripts/format_venue_json.py --to-repo to push changes back to data/.
curation/

# Database dumps -- may contain data. Never commit.
*.sql.bak
backup_*.sql
*_backup.sql
supabase/.temp/
backups/

# Flutter platform folders not targeted for this project
mobile/linux/
mobile/macos/
mobile/windows/
mobile/web/

# Flutter/Gradle secrets that must never be committed
mobile/android/local.properties
mobile/android/key.properties
mobile/android/*.keystore
mobile/android/*.jks
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist

# Live database snapshots taken by scripts/export_live_snapshot.py.
# These hold full table dumps including signal and event_log, which carry
# user identifiers, so they stay out of version control. Curated venue data
# extracted from a snapshot goes into data/ in the normal curated format.
data/live_snapshot/
